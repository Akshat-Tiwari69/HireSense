# PostgreSQL (URL-encode reserved characters in passwords)
# Production runtime connections must use hiresense_app and explicit TLS.
DATABASE_URL=postgresql://hiresense_app:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full&sslrootcert=/etc/ssl/certs/supabase-prod-ca-2021.crt
# Optional administrator connection used only by scripts/run_migration.py.
DATABASE_ADMIN_URL=postgresql://ADMIN:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full&sslrootcert=/etc/ssl/certs/supabase-prod-ca-2021.crt
DB_STATEMENT_TIMEOUT_MS=30000
# Per-process pool. Keep this small when DATABASE_URL points at Supabase.
DB_POOL_MIN=1
DB_POOL_MAX=8
DB_POOL_ACQUIRE_TIMEOUT_SECONDS=5

# Runtime mode. Admin-driven .env edits are disabled unless both development
# mode and the explicit opt-in below are enabled.
APP_ENV=development
ALLOW_RUNTIME_ENV_MUTATION=false

# Authentication (generate a random secret of at least 32 characters)
JWT_SECRET_KEY=
# Staff bearer-token lifetime; accepted range is 5-480 minutes.
JWT_ACCESS_TOKEN_MINUTES=60
ALLOW_INSECURE_DEV_SECRET=false

# Browser clients and links
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
# Exact trusted reverse-proxy count. Use 1 on Railway; keep 0 without a proxy.
TRUST_PROXY_HOPS=0

# Optional shared rate-limit storage for multi-process production deployments
REDIS_URL=

# Private resumes and proctoring evidence. The default backend/uploads folder
# is suitable only for local development; production should use a persistent volume.
UPLOAD_FOLDER=

# OpenAI-backed analysis/question generation (features fall back locally if unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_RESUME_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=1

# Technical scheduling stays disabled until an isolated code runner is available.
CODE_RUNNER_ENABLED=false
# When enabled, keep a self-hosted Piston API loopback-only.
CODE_RUNNER_URL=

# Email: auto, smtp, or resend
EMAIL_PROVIDER=auto
EMAIL_TIMEOUT_SECONDS=15
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SSL_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=HireSense

# Optional outbound proxy settings honored by HTTP clients
HTTP_PROXY=
HTTPS_PROXY=
