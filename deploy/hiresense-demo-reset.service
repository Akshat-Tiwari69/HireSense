[Unit]
Description=Reset HireSense public demo data
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hiresense
Group=hiresense
WorkingDirectory=/opt/hiresense/current
EnvironmentFile=/etc/hiresense/hiresense.env
UnsetEnvironment=DATABASE_ADMIN_URL
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# Pause the public API (about two minutes at 03:30) so no request sees a half-seeded
# demo and no upload lands between the reset and the reseed. The seeder runs the app
# in-process, and ExecStopPost restarts the API even if seeding fails.
ExecStartPre=+/usr/bin/systemctl stop hiresense.service
ExecStart=/opt/hiresense/current/.venv/bin/python database/seed_demo.py --reset
ExecStopPost=+/usr/bin/systemctl start hiresense.service
TimeoutStartSec=20min
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hiresense/uploads
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
