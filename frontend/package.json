    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.0",
    "events": "^3.3.0",
    "lucide-react": "^0.424.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.12.0",
